# ── Database ─────────────────────────────────────────────
# Leave DATABASE_URL unset locally to use SQLite (./stockbook.db, zero setup).
# For Supabase / Vercel, paste the "Transaction pooler" connection string:
#   Supabase Dashboard → Connect → Transaction pooler
#   (looks like: postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres)
# DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────
# Long random string (required in production): openssl rand -hex 32
JWT_SECRET=change-me

# First-run admin account (only used when the users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
